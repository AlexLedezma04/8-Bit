.{
    .name = "Assembly",
    .extensions = .{ "asm", "s", "nasm", "inc" },
    .line_comments = .{ ";", "#" },
    .strings = .{ .{ .start = "\"" }, .{ .start = "'" }, .{ .start = "`" } },
    .keywords = .{
        "adc",    "add",    "and",     "bits",  "bswap",  "call",   "cbw",   "cdq",    "cld",    "cli",     "cmova",
        "cmovae", "cmovb",  "cmovbe",  "cmove", "cmovg",  "cmovge", "cmovl", "cmovle", "cmovne", "cmp",     "cmpxchg",
        "cpuid",  "cqo",    "cwd",     "db",    "dd",     "dec",    "div",   "dq",     "dw",     "enter",   "equ",
        "extern", "global", "hlt",     "idiv",  "imul",   "inc",    "int",   "ja",     "jae",    "jb",      "jbe",
        "jc",     "je",     "jg",      "jge",   "jl",     "jle",    "jmp",   "jnc",    "jne",    "jno",     "jns",
        "jnz",    "jo",     "js",      "jz",    "lea",    "leave",  "lock",  "loop",   "mov",    "movabs",  "movsb",
        "movsd",  "movsq",  "movsw",   "movsx", "movsxd", "movzx",  "mul",   "neg",    "nop",    "not",     "or",
        "org",    "pop",    "popf",    "push",  "pushf",  "rcl",    "rcr",   "rep",    "repe",   "repne",   "resb",
        "resd",   "resq",   "resw",    "ret",   "rol",    "ror",    "sal",   "sar",    "sbb",    "section", "setc",
        "sete",   "setg",   "setl",    "setne", "shl",    "shr",    "stc",   "std",    "sti",    "stosb",   "stosd",
        "stosq",  "sub",    "syscall", "test",  "times",  "xchg",   "xor",
    },
    .types = .{
        "al",  "ah",   "ax",   "eax",  "rax",  "bl",   "bh",   "bx",   "ebx",  "rbx", "cl",  "ch",  "cx",  "ecx",
        "rcx", "dl",   "dh",   "dx",   "edx",  "rdx",  "si",   "esi",  "rsi",  "di",  "edi", "rdi", "sp",  "esp",
        "rsp", "bp",   "ebp",  "rbp",  "ip",   "eip",  "rip",  "r8",   "r9",   "r10", "r11", "r12", "r13", "r14",
        "r15", "r8d",  "r9d",  "r10d", "r11d", "r12d", "r13d", "r14d", "r15d", "cs",  "ds",  "es",  "fs",  "gs",
        "ss",  "xmm0", "xmm1", "xmm2", "xmm3", "xmm4", "xmm5", "xmm6", "xmm7",
    },
    .builtins = .{ "byte", "word", "dword", "qword", "ptr", "rel" },
    .ignore_case = true,
    .functions = false,
    .key_before = ":",
    .operators = "+-*/",
    .punctuation = "[],",
    .prefixes = .{
        .{ .text = ".", .style = .keyword },
        .{ .text = "%", .style = .type },
        .{ .text = "$", .style = .constant },
    },
}
