.{
    .name = "Cairo",
    .extensions = .{"cairo"},
    .line_comments = .{"//"},
    .strings = .{ .{ .start = "\"" }, .{ .start = "'" } },
    .keywords = .{
        "as",        "break",  "const", "continue", "else", "enum",  "extern", "fn",  "if",  "impl",
        "implicits", "let",    "loop",  "match",    "mod",  "mut",   "of",     "pub", "ref", "return",
        "self",      "struct", "trait", "type",     "use",  "while",
    },
    .types = .{
        "felt252", "u8",   "u16",  "u32",       "u64",   "u128",   "u256",   "usize",           "i8", "i16", "i32",
        "i64",     "i128", "bool", "ByteArray", "Array", "Option", "Result", "ContractAddress",
    },
    .constants = .{ "true", "false", "None", "Some", "Ok", "Err" },
    .operators = "+-*/%=<>!&|^~?:",
    .prefixes = .{.{ .text = "#", .style = .builtin }},
}
