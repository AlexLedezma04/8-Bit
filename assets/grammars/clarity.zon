.{
    .name = "Clarity",
    .extensions = .{"clar"},
    .line_comments = .{";"},
    .strings = .{ .{ .start = "\"" }, .{ .start = "u\"", .end = "\"" } },
    .keywords = .{
        "define-public",   "define-private", "define-read-only",      "define-constant",
        "define-data-var", "define-map",     "define-fungible-token", "define-non-fungible-token",
        "define-trait",    "impl-trait",     "use-trait",             "let",
        "begin",           "if",             "match",                 "asserts!",
        "unwrap!",         "unwrap-panic",   "try!",                  "ok",
        "err",             "some",
    },
    .types = .{
        "int",   "uint",     "bool",     "principal", "buff", "string-ascii", "string-utf8", "list",
        "tuple", "optional", "response",
    },
    .constants = .{ "true", "false", "none", "tx-sender", "block-height", "contract-caller" },
    .builtins = .{
        "map-get?",     "map-set",       "map-insert",    "map-delete", "var-get", "var-set", "get",
        "ft-transfer?", "nft-transfer?", "stx-transfer?", "print",      "and",     "or",      "not",
        "is-eq",
    },
    .functions = false,
    .operators = "'",
    .punctuation = "(){}",
    .word_chars = "-*+!?<>=/&%$.:",
}
