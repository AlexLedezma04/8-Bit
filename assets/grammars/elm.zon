.{
    .name = "Elm",
    .extensions = .{"elm"},
    .line_comments = .{"--"},
    .block_comment = .{ .start = "{-", .end = "-}" },
    .strings = .{ .{ .start = "\"\"\"", .multiline = true }, .{ .start = "\"" }, .{ .start = "'" } },
    .keywords = .{
        "alias", "as",   "case", "else",  "exposing", "if", "import", "in", "let", "module", "of",
        "port",  "then", "type", "where",
    },
    .types = .{
        "Bool", "Char", "Float", "Int", "List", "Maybe", "Result", "String", "Cmd", "Sub",
        "Html", "Msg",  "Model",
    },
    .constants = .{ "True", "False", "Nothing", "Just", "Ok", "Err" },
    .functions = false,
    .operators = "+-*/=<>!&|^.:\\",
}
