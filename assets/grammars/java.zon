.{
    .name = "Java",
    .extensions = .{"java"},
    .line_comments = .{"//"},
    .block_comment = .{ .start = "/*", .end = "*/" },
    .strings = .{ .{ .start = "\"\"\"", .multiline = true }, .{ .start = "\"" }, .{ .start = "'" } },
    .keywords = .{
        "abstract", "assert",     "break",   "case",       "catch",        "class",  "const",    "continue", "default",
        "do",       "else",       "enum",    "exports",    "extends",      "final",  "finally",  "for",      "goto",
        "if",       "implements", "import",  "instanceof", "interface",    "module", "native",   "new",      "non-sealed",
        "package",  "permits",    "private", "protected",  "public",       "record", "requires", "return",   "sealed",
        "static",   "strictfp",   "super",   "switch",     "synchronized", "this",   "throw",    "throws",   "transient",
        "try",      "var",        "void",    "volatile",   "while",        "yield",
    },
    .types = .{
        "boolean", "byte",     "char", "short",  "int",   "long",    "float",     "double", "String",
        "Object",  "Integer",  "Long", "Double", "Float", "Boolean", "Character", "List",   "Map",
        "Set",     "Optional",
    },
    .constants = .{ "true", "false", "null" },
    .operators = "+-*/%=<>!&|^~?:",
    .prefixes = .{.{ .text = "@", .style = .builtin }},
}
