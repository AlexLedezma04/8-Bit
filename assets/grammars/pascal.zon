.{
    .name = "Pascal",
    .extensions = .{ "pas", "pp", "dpr", "lpr", "dpk" },
    .line_comments = .{"//"},
    .block_comment = .{ .start = "{", .end = "}" },
    .strings = .{
        .{ .start = "(*", .end = "*)", .escape = false, .multiline = true, .style = .comment },
        .{ .start = "'", .escape = false },
    },
    .keywords = .{
        "and",            "array",    "as",             "asm",      "begin",     "case",      "class",          "const",    "constructor",
        "destructor",     "div",      "do",             "downto",   "else",      "end",       "except",         "exports",  "file",
        "finalization",   "finally",  "for",            "function", "goto",      "if",        "implementation", "in",       "inherited",
        "initialization", "inline",   "interface",      "is",       "label",     "library",   "mod",            "nil",      "not",
        "object",         "of",       "or",             "out",      "packed",    "procedure", "program",        "property", "raise",
        "record",         "repeat",   "resourcestring", "set",      "shl",       "shr",       "string",         "then",     "threadvar",
        "to",             "try",      "type",           "unit",     "until",     "uses",      "var",            "while",    "with",
        "xor",            "override", "virtual",        "private",  "protected", "public",    "published",
    },
    .types = .{
        "integer", "cardinal", "shortint", "smallint", "longint", "int64",    "byte",   "word",
        "boolean", "char",     "real",     "single",   "double",  "extended", "string", "ansistring",
        "pointer", "variant",
    },
    .constants = .{ "true", "false", "nil" },
    .builtins = .{
        "writeln", "write", "readln", "read", "inc", "dec", "length", "setlength", "high",
        "low",     "ord",   "chr",
    },
    .ignore_case = true,
    .operators = "+-*/=<>:@^",
    .punctuation = "()[],;",
}
