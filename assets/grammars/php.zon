.{
    .name = "PHP",
    .extensions = .{ "php", "phtml" },
    .shebangs = .{"php"},
    .line_comments = .{ "//", "#" },
    .block_comment = .{ .start = "/*", .end = "*/" },
    .strings = .{ .{ .start = "\"" }, .{ .start = "'" } },
    .keywords = .{
        "abstract",   "and",          "as",         "break",     "callable",  "case",     "catch",    "class",   "clone",
        "const",      "continue",     "declare",    "default",   "do",        "echo",     "else",     "elseif",  "empty",
        "enddeclare", "endfor",       "endforeach", "endif",     "endswitch", "endwhile", "enum",     "extends", "final",
        "finally",    "fn",           "for",        "foreach",   "function",  "global",   "goto",     "if",      "implements",
        "include",    "include_once", "instanceof", "insteadof", "interface", "isset",    "list",     "match",   "namespace",
        "new",        "or",           "print",      "private",   "protected", "public",   "readonly", "require", "require_once",
        "return",     "static",       "switch",     "throw",     "trait",     "try",      "unset",    "use",     "var",
        "while",      "xor",          "yield",
    },
    .types = .{
        "int",   "float", "bool",   "string", "array", "object", "mixed", "void", "iterable",
        "never", "self",  "parent",
    },
    .constants = .{ "true", "false", "null", "TRUE", "FALSE", "NULL" },
    .operators = "+-*/%=<>!&|^~?:.",
    .prefixes = .{ .{ .text = "<?", .style = .keyword }, .{ .text = "$", .style = .builtin } },
}
