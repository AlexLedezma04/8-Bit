.{
    .name = "Rust",
    .extensions = .{"rs"},
    .line_comments = .{"//"},
    .block_comment = .{ .start = "/*", .end = "*/" },
    .strings = .{
        .{ .start = "r#\"", .end = "\"#", .escape = false, .multiline = true },
        .{ .start = "\"", .multiline = true },
    },
    .keywords = .{
        "as",     "async", "await", "break",  "const",  "continue", "crate", "dyn",    "else",   "enum",
        "extern", "fn",    "for",   "if",     "impl",   "in",       "let",   "loop",   "match",  "mod",
        "move",   "mut",   "pub",   "ref",    "return", "self",     "Self",  "static", "struct", "super",
        "trait",  "type",  "union", "unsafe", "use",    "where",    "while",
    },
    .types = .{
        "i8",      "i16", "i32",  "i64",  "i128", "isize",  "u8",  "u16",    "u32",    "u64", "u128", "usize",
        "f32",     "f64", "bool", "char", "str",  "String", "Vec", "Option", "Result", "Box", "Rc",   "Arc",
        "HashMap",
    },
    .constants = .{ "true", "false", "None", "Some", "Ok", "Err" },
    .operators = "+-*/%=<>!&|^?",
    .prefixes = .{.{ .text = "#", .style = .builtin }},
}
