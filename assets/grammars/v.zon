.{
    .name = "V",
    .extensions = .{ "v", "vsh", "vv" },
    .hints = .{ "fn ", "import " },
    .line_comments = .{"//"},
    .block_comment = .{ .start = "/*", .end = "*/" },
    .strings = .{ .{ .start = "\"" }, .{ .start = "'" }, .{ .start = "`" } },
    .keywords = .{
        "as",     "asm",    "assert", "atomic", "break",  "const",  "continue", "defer",     "else",   "enum",
        "fn",     "for",    "go",     "goto",   "if",     "import", "in",       "interface", "is",     "isreftype",
        "lock",   "match",  "module", "mut",    "none",   "or",     "pub",      "return",    "rlock",  "select",
        "shared", "sizeof", "spawn",  "static", "struct", "type",   "typeof",   "union",     "unsafe",
    },
    .types = .{
        "bool", "string", "i8",   "i16",  "int",     "i64", "i128", "u8", "u16", "u32", "u64", "u128",
        "f32",  "f64",    "rune", "byte", "voidptr", "any",
    },
    .constants = .{ "true", "false", "none" },
    .operators = "+-*/%=<>!&|^~?:",
    .prefixes = .{ .{ .text = "@", .style = .builtin }, .{ .text = "$", .style = .keyword } },
}
