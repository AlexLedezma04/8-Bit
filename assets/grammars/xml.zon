.{
    .name = "XML",
    .extensions = .{
        "xml",  "xsd", "xsl",  "xslt", "svg", "plist", "csproj", "vcxproj", "props", "targets",
        "xaml", "rss", "atom",
    },
    .block_comment = .{ .start = "<!--", .end = "-->" },
    .strings = .{ .{ .start = "\"", .escape = false }, .{ .start = "'", .escape = false } },
    .numbers = false,
    .functions = false,
    .key_before = "=",
    .punctuation = "<>/",
    .word_chars = "-:.",
    .prefixes = .{
        .{ .text = "</", .style = .keyword },
        .{ .text = "<?", .style = .keyword },
        .{ .text = "<!", .style = .keyword },
        .{ .text = "<", .style = .keyword },
        .{ .text = "&", .style = .constant },
    },
}
